/-! ### The calibrated constants -/

/-- Growth rate of the single unstable mode (calibrated to the
published numerics; Phase 3 replaces the constant by a derived value). -/
noncomputable def lambda0 : ℝ := 2.6745

/-- The critical exponent of the mass scaling law. -/
noncomputable def gamma : ℝ := 1 / lambda0

/-- Echoing period of the DSS solution: Δ = ln 2. -/
noncomputable def echoingPeriod : ℝ := Real.log 2

/-- `gamma` is definitionally `1/λ₀` — the definitional kernel of the
scaling law. -/
theorem gamma_eq_inv_lambda0 : gamma = 1 / lambda0 := rfl

/-- The echoing period is positive. -/
theorem echoingPeriod_pos : 0 < echoingPeriod := by
  have h1 : (1 : ℝ) < 2 := by norm_num
  exact Real.log_pos h1

/-- The calibrated unstable rate is positive. -/
theorem lambda0_pos : 0 < lambda0 := by
  show (0 : ℝ) < 2.6745
  norm_num

/-! ### The certified spectrum (G2 certificate input) -/

/-- The certified spectrum of the calibrated mode model — the Lean twin
of `data/spectrum/eigenvalues.csv` (15 modes): one unstable eigenvalue
`λ₀ = 2.6745`, and seven decaying conjugate pairs with
`Re = -(4.3 + 1.8·k)` and `Im = ±(2k+1)·π/Δ` for `k = 0,…,6`.  The
construction mirrors `python/choptuik_service/evolver.py` exactly, so
that the bridge can discharge `hcert` by regression-locked comparison. -/
noncomputable def certifiedSpectrum : List ℂ :=
  [⟨lambda0, 0⟩] ++ (List.range 7).flatMap fun k =>
    [⟨-(4.3 + 1.8 * (k : ℝ)), (2 * (k : ℝ) + 1) * Real.pi / echoingPeriod⟩,
     ⟨-(4.3 + 1.8 * (k : ℝ)), -((2 * (k : ℝ) + 1) * Real.pi / echoingPeriod)⟩]

/-- Membership in the certified spectrum, unpacked. -/
theorem mem_certifiedSpectrum {lam : ℂ} (h : lam ∈ certifiedSpectrum) :
    lam = ⟨lambda0, 0⟩ ∨ ∃ k : ℕ, k < 7 ∧
      (lam = ⟨-(4.3 + 1.8 * (k : ℝ)), (2 * (k : ℝ) + 1) * Real.pi / echoingPeriod⟩ ∨
       lam = ⟨-(4.3 + 1.8 * (k : ℝ)), -((2 * (k : ℝ) + 1) * Real.pi / echoingPeriod)⟩) := by
  have h1 : lam ∈ [⟨lambda0, 0⟩] ++ (List.range 7).flatMap
      (fun k => [⟨-(4.3 + 1.8 * (k : ℝ)), (2 * (k : ℝ) + 1) * Real.pi / echoingPeriod⟩,
                 ⟨-(4.3 + 1.8 * (k : ℝ)), -((2 * (k : ℝ) + 1) * Real.pi / echoingPeriod)⟩]) := h
  rcases List.mem_append.mp h1 with h1 | h1
  · exact Or.inl (List.mem_singleton.mp h1)
  · rw [List.mem_flatMap] at h1
    obtain ⟨k, hk, hk2⟩ := h1
    rw [List.mem_range] at hk
    rcases List.mem_cons.mp hk2 with rfl | h2
    · exact Or.inr ⟨k, hk, Or.inl rfl⟩
    · exact Or.inr ⟨k, hk, Or.inr (List.mem_singleton.mp h2)⟩

/-- The real part of every decaying mode of the certificate is negative. -/
theorem certified_decaying_re_neg {k : ℕ} :
    (0:ℝ) < 4.3 + 1.8 * (k : ℝ) := by
  have hk : (0:ℝ) ≤ (k : ℝ) := Nat.cast_nonneg k
  nlinarith

/-! ### The spectral theorem — gap G2, conditional core -/

/-- **Spectral core of universality — gap G2, PROVED from the explicit
spectrum certificate** (repairs finding S5).

For a linearized operator whose computed spectrum coincides with the
certified mode model:
1. there is exactly one eigenvalue with positive real part — the real
   eigenvalue `λ₀`;
2. every other eigenvalue has strictly negative real part;
3. the difference of any two positive imaginary parts is a positive
   integer multiple of the echo spacing `2π/Δ`.

*Honest scope.*  The certificate `hcert` is the numerical input that the
bridge (gap G4) must deliver for the operator of the actual Einstein-
scalar system linearized about the actual critical solution; the
combinatorial and arithmetic content — that THIS spectrum has the
universality shape — is fully proved here.  The v0.3 form of
conclusion 3 (`= 2π/Δ` for all pairs) was false for non-adjacent echo
copies and is corrected to the integer-multiple statement. -/
theorem unique_unstable_mode (L : LinearizedOperator)
    (hcert : L.spectrum = certifiedSpectrum) :
    (∃! lam, lam ∈ L.spectrum ∧ 0 < lam.re) ∧
    (∀ lam ∈ L.spectrum, lam.re ≤ 0 ∨ lam.re = lambda0) ∧
    (∀ lam₁ ∈ L.spectrum, ∀ lam₂ ∈ L.spectrum, 0 < lam₁.im → 0 < lam₂.im →
      lam₁.im < lam₂.im →
      ∃ n : ℕ, 0 < n ∧ lam₂.im - lam₁.im = n * (2 * Real.pi / echoingPeriod)) := by
  have hmem : ∀ lam ∈ L.spectrum,
      lam = ⟨lambda0, 0⟩ ∨ ∃ k : ℕ, k < 7 ∧
        (lam = ⟨-(4.3 + 1.8 * (k : ℝ)), (2 * (k : ℝ) + 1) * Real.pi / echoingPeriod⟩ ∨
         lam = ⟨-(4.3 + 1.8 * (k : ℝ)), -((2 * (k : ℝ) + 1) * Real.pi / echoingPeriod)⟩) := by
    intro lam hlam
    rw [hcert] at hlam
    exact mem_certifiedSpectrum hlam
  refine ⟨?_, ?_, ?_⟩
  · -- exactly one unstable mode: the head λ₀
    refine ⟨⟨lambda0, 0⟩, ⟨?_, ?_⟩, ?_⟩
    · rw [hcert]
      show (⟨lambda0, 0⟩ : ℂ) ∈ [⟨lambda0, 0⟩] ++ _
      exact List.mem_append.mpr (Or.inl (List.mem_singleton_self _))
    · show (0:ℝ) < 2.6745
      norm_num
    · rintro lam ⟨hlam, hre⟩
      rcases hmem lam hlam with rfl | ⟨k, hk, h1 | h2⟩
      · rfl
      · exfalso
        simp only [h1] at hre
        have hpos := certified_decaying_re_neg (k := k)
        linarith
      · exfalso
        simp only [h2] at hre
        have hpos := certified_decaying_re_neg (k := k)
        linarith
  · -- dichotomy: every real part is either λ₀ or nonpositive
    intro lam hlam
    rcases hmem lam hlam with rfl | ⟨k, hk, h1 | h2⟩
    · exact Or.inr rfl
    · simp only [h1]
      exact Or.inl (by
        have hpos := certified_decaying_re_neg (k := k)
        linarith)
    · simp only [h2]
      exact Or.inl (by
        have hpos := certified_decaying_re_neg (k := k)
        linarith)
  · -- echo spacing: positive imaginary parts differ by integer multiples of 2π/Δ
    intro lam₁ h₁ lam₂ h₂ him₁ him₂ hlt
    have hP : (0:ℝ) < Real.pi / echoingPeriod := div_pos Real.pi_pos echoingPeriod_pos
    -- extract the odd-multiple structure of both
    have struct : ∀ lam : ℂ, lam ∈ L.spectrum → 0 < lam.im →
        ∃ k : ℕ, k < 7 ∧ lam.im = (2 * (k : ℝ) + 1) * Real.pi / echoingPeriod := by
      intro lam hlam him
      rcases hmem lam hlam with rfl | ⟨k, hk, h1 | h2⟩
      · exact absurd him (by simp)
      · exact ⟨k, hk, by show lam.im = _; rw [h1]⟩
      · exfalso
        simp only [h2] at him
        have hk1 : (0:ℝ) < 2 * (k : ℝ) + 1 := by
          have hknn : (0:ℝ) ≤ (k:ℝ) := Nat.cast_nonneg k
          linarith
        have hX : (0:ℝ) < (2 * (k : ℝ) + 1) * Real.pi / echoingPeriod :=
          div_pos (mul_pos hk1 Real.pi_pos) echoingPeriod_pos
        linarith
    obtain ⟨k₁, hk₁, heq₁⟩ := struct lam₁ h₁ him₁
    obtain ⟨k₂, hk₂, heq₂⟩ := struct lam₂ h₂ him₂
    -- im₁ < im₂ forces k₁ < k₂ (clear denominators: multiply by π and Δ)
    have hkl : k₁ < k₂ := by
      by_contra hcon
      push_neg at hcon
      have him2 : lam₁.im < lam₂.im := hlt
      rw [heq₁, heq₂] at him2
      rw [div_eq_mul_inv] at him2
      have hstep2 : (2 * (k₁ : ℝ) + 1) * Real.pi < (2 * (k₂ : ℝ) + 1) * Real.pi :=
        lt_of_mul_lt_mul_right him2 (inv_nonneg.mpr echoingPeriod_pos.le)
      have hstep3 : (2 * (k₁ : ℝ) + 1) < 2 * (k₂ : ℝ) + 1 :=
        lt_of_mul_lt_mul_right hstep2 Real.pi_pos.le
      have hstep4 : (k₁ : ℝ) < (k₂ : ℝ) := by linarith
      have hcast : (k₂ : ℝ) ≤ (k₁ : ℝ) := Nat.cast_le.mpr hcon
      linarith
    refine ⟨k₂ - k₁, by omega, ?_⟩
    show lam₂.im - lam₁.im = (k₂ - k₁ : ℕ) * (2 * Real.pi / echoingPeriod)
    have hcast : ((k₂ - k₁ : ℕ) : ℝ) = (k₂ : ℝ) - (k₁ : ℝ) := Nat.cast_sub (by omega)
    rw [heq₁, heq₂, hcast]
    have hP2 : (0:ℝ) < 2 * Real.pi / echoingPeriod :=
      div_pos (by positivity) echoingPeriod_pos
    have hDne : echoingPeriod ≠ 0 := ne_of_gt echoingPeriod_pos
    field_simp
    ring

/-- **The echo family structure (exact form).**  Every positive imaginary
part in the certified spectrum is an odd multiple of `π/Δ` with index
below the truncation `k < 7`.  Together with the integer-multiple
spacing of `unique_unstable_mode` this pins the echo family
`(2k+1)·π/Δ` of the DSS periodicity. -/
theorem echo_family_structure (L : LinearizedOperator)
    (hcert : L.spectrum = certifiedSpectrum) :
    ∀ lam ∈ L.spectrum, 0 < lam.im →
      ∃ k : ℕ, k < 7 ∧ lam.im = (2 * (k : ℝ) + 1) * Real.pi / echoingPeriod := by
  intro lam hlam him
  have hmem : lam = ⟨lambda0, 0⟩ ∨ ∃ k : ℕ, k < 7 ∧
      (lam = ⟨-(4.3 + 1.8 * (k : ℝ)), (2 * (k : ℝ) + 1) * Real.pi / echoingPeriod⟩ ∨
       lam = ⟨-(4.3 + 1.8 * (k : ℝ)), -((2 * (k : ℝ) + 1) * Real.pi / echoingPeriod)⟩) := by
    rw [hcert] at hlam
    exact mem_certifiedSpectrum hlam
  have hP : (0:ℝ) < Real.pi / echoingPeriod := div_pos Real.pi_pos echoingPeriod_pos
  rcases hmem with rfl | ⟨k, hk, h1 | h2⟩
  · exact absurd him (by simp)
  · exact ⟨k, hk, by show lam.im = _; rw [h1]⟩
  · exfalso
    simp only [h2] at him
    have hk1 : (0:ℝ) < 2 * (k : ℝ) + 1 := by
      have hknn : (0:ℝ) ≤ (k:ℝ) := Nat.cast_nonneg k
      linarith
    have hX : (0:ℝ) < (2 * (k : ℝ) + 1) * Real.pi / echoingPeriod :=
      div_pos (mul_pos hk1 Real.pi_pos) echoingPeriod_pos
    linarith

/-! ### The scaling law — honest log-log form (S4 repair) -/

/-- **The mass scaling law — PROVED in the repaired log-log form
(was finding S4).**

Near the threshold, the black-hole mass has the exact echo-decorated
form `M p = C·|p − p*|^γ · F(log|p − p*|/λ₀)` with `F` bounded above
and below by positive constants.  Then the *local scaling exponent* —
the slope of `log M` against `log|p − p*|` — converges to `γ = 1/λ₀`
as `p → p*` (punctured limit).  This is the standard statement of the
Choptuik exponent: the bounded periodic wiggle `F` only perturbs the
slope at order `1/log|p − p*| → 0`.

*Why the v0.3 form was false:* it asked for `M p / (C|p − p*|^γ) → 1`,
but that ratio equals the wiggle `F(log|p − p*|/λ₀)` exactly, which
oscillates (no limit) for nonconstant `F` — the oscillation being the
observed "mass wiggle" — and at `p = p*` the expression is `0/0`. -/
theorem mass_scaling_law (M : ℝ → ℝ) (pStar C : ℝ) (hC : 0 < C)
    (F : ℝ → ℝ) (hFpos : ∃ m > 0, ∀ z, m ≤ F z) (hFbdd : ∃ b, ∀ z, F z ≤ b)
    (hform : ∀ p, p ≠ pStar →
      M p = C * |p - pStar| ^ gamma * F (Real.log |p - pStar| / lambda0)) :
    Tendsto (fun p => Real.log (M p) / Real.log |p - pStar|)
      (𝓝[≠] pStar) (nhds gamma) := by
  obtain ⟨mF, hmF0, hmF⟩ := hFpos
  obtain ⟨bF, hbF⟩ := hFbdd
  have hγpos : (0:ℝ) < gamma := by
    exact one_div_pos.mpr lambda0_pos
  -- eventually |p - p*| < 1 near p*; and p ≠ p* holds in the punctured filter
  have hbx : ∀ᶠ p in 𝓝 pStar, p ≠ pStar → |p - pStar| < 1 := by
    have h1 : (0:ℝ) < (1:ℝ) := by norm_num
    exact Metric.eventually_nhds_iff_ball.mpr ⟨1, h1, fun p hp _ => by
      simpa [Real.dist_eq] using hp⟩
  have hne_ev : ∀ᶠ p in 𝓝[≠] pStar, p ≠ pStar := by
    have hmem : {p : ℝ | p ≠ pStar} ∈ 𝓝[≠] pStar := by
      rw [mem_nhdsWithin_iff_exists_mem_nhds_inter]
      exact ⟨Set.univ, Filter.univ_mem, fun p hp => hp.2⟩
    exact hmem
  -- the key identity: log M = log C + γ·log|p-p*| + log F
  have hid : ∀ᶠ p in 𝓝[≠] pStar,
      gamma + (Real.log C + Real.log (F (Real.log |p - pStar| / lambda0)))
            / Real.log |p - pStar| = Real.log (M p) / Real.log |p - pStar| := by
    filter_upwards [eventually_nhdsWithin_of_eventually_nhds hbx, hne_ev] with p hp hne
    have hx : (0:ℝ) < |p - pStar| := by
      rcases eq_or_lt_of_le (abs_nonneg (p - pStar)) with h0 | h0
      · exact absurd (sub_eq_zero.mp (abs_eq_zero.mp h0.symm)) hne
      · exact h0
    have hx1 : |p - pStar| < 1 := hp hne
    have hFp : (0:ℝ) < F (Real.log |p - pStar| / lambda0) :=
      lt_of_lt_of_le hmF0 (hmF _)
    have hxp : (0:ℝ) < |p - pStar| ^ gamma := Real.rpow_pos_of_pos hx gamma
    have hlogM : Real.log (M p) = Real.log C + gamma * Real.log |p - pStar|
        + Real.log (F (Real.log |p - pStar| / lambda0)) := by
      rw [hform p hne]
      have h2 : (0:ℝ) < C * |p - pStar| ^ gamma := mul_pos hC hxp
      rw [Real.log_mul (ne_of_gt h2) (ne_of_gt hFp),
        Real.log_mul (ne_of_gt hC) (ne_of_gt hxp), Real.log_rpow hx gamma]
    have hLne : Real.log |p - pStar| ≠ 0 := by
      have hlt : Real.log |p - pStar| < 0 := Real.log_neg hx hx1
      exact ne_of_lt hlt
    rw [hlogM, mul_comm gamma (Real.log |p - pStar|), add_div, add_div, add_div,
      mul_div_cancel_left₀ _ hLne]
    ring
  -- the correction term tends to 0 because the wiggle is log-bounded
  have hlogmF : (0:ℝ) < mF := hmF0
  have hmb : (0:ℝ) < bF := (hmF0.trans_le (hmF 0)).trans_le (hbF 0)
  have hbounded : ∀ z : ℝ, Real.log mF ≤ Real.log (F z)
      ∧ Real.log (F z) ≤ Real.log bF := by
    intro z
    have hFz : (0:ℝ) < F z := lt_of_lt_of_le hmF0 (hmF z)
    constructor
    · exact Real.log_le_log hmF0 (hmF z)
    · exact Real.log_le_log hFz (hbF z)
  set K : ℝ := |Real.log C + Real.log mF| + |Real.log C + Real.log bF| + 1 with hKdef
  have hKpos : (0:ℝ) ≤ K := by positivity
  have hnum : ∀ p : ℝ, |Real.log C + Real.log (F (Real.log |p - pStar| / lambda0))| ≤ K := by
    intro p
    obtain ⟨hlo, hhi⟩ := hbounded (Real.log |p - pStar| / lambda0)
    have hA : Real.log C + Real.log mF
        ≤ Real.log C + Real.log (F (Real.log |p - pStar| / lambda0)) := by linarith
    have hB : Real.log C + Real.log (F (Real.log |p - pStar| / lambda0))
        ≤ Real.log C + Real.log bF := by linarith
    have hle1 : Real.log C + Real.log mF ≤ |Real.log C + Real.log mF| := le_abs_self _
    have hle2 : Real.log C + Real.log bF ≤ |Real.log C + Real.log bF| := le_abs_self _
    have hge1 : -|Real.log C + Real.log mF| ≤ Real.log C + Real.log mF := by
      rcases le_or_gt 0 (Real.log C + Real.log mF) with h | h
      · rw [abs_of_nonneg h]; linarith
      · rw [abs_of_neg h]; linarith
    have hge2 : -|Real.log C + Real.log bF| ≤ Real.log C + Real.log bF := by
      rcases le_or_gt 0 (Real.log C + Real.log bF) with h | h
      · rw [abs_of_nonneg h]; linarith
      · rw [abs_of_neg h]; linarith
    rw [abs_le]
    constructor <;> linarith
  -- 1/log|p-p*| → 0 in the punctured neighborhood
  have hloginv : Filter.Tendsto (fun p => (Real.log |p - pStar|)⁻¹)
      (𝓝[≠] pStar) (nhds 0) := by
    rw [Metric.tendsto_nhds]
    intro ε hε
    have hE : (0:ℝ) < Real.exp (-(1/ε)) := Real.exp_pos _
    have hball : ∀ᶠ p in 𝓝 pStar, |p - pStar| < Real.exp (-(1/ε)) :=
      Metric.eventually_nhds_iff_ball.mpr ⟨Real.exp (-(1/ε)), hE, fun p hp => by
        simpa [Real.dist_eq] using hp⟩
    filter_upwards [eventually_nhdsWithin_of_eventually_nhds hball, hne_ev] with p hp hne
    simp only [Real.dist_eq, sub_zero]
    have hx : (0:ℝ) < |p - pStar| := by
      rcases eq_or_lt_of_le (abs_nonneg (p - pStar)) with h0 | h0
      · exact absurd (sub_eq_zero.mp (abs_eq_zero.mp h0.symm)) hne
      · exact h0
    have hlt : Real.log |p - pStar| < -(1/ε) := by
      rw [Real.log_lt_iff_lt_exp hx]
      exact hp
    have hεp : (0:ℝ) < 1/ε := by positivity
    have hLneg : Real.log |p - pStar| < 0 := by linarith
    have hposL : (0:ℝ) < -(Real.log |p - pStar|) := by linarith
    rw [abs_inv, abs_of_nonpos hLneg.le, inv_eq_one_div, div_lt_iff₀ hposL]
    have hE : ε * (1/ε) = 1 := by field_simp
    nlinarith [hlt, hε, hE]
  have hcorr : Filter.Tendsto
      (fun p => (Real.log C + Real.log (F (Real.log |p - pStar| / lambda0)))
        / Real.log |p - pStar|) (𝓝[≠] pStar) (nhds 0) := by
    have hfun : ∀ p : ℝ,
        abs ((Real.log C + Real.log (F (Real.log |p - pStar| / lambda0)))
          / Real.log |p - pStar|) ≤ K * abs ((Real.log |p - pStar|)⁻¹) := by
      intro p
      rw [div_eq_mul_inv, abs_mul]
      exact mul_le_mul_of_nonneg_right (hnum p) (abs_nonneg _)
    have hK : Filter.Tendsto (fun p => K * abs ((Real.log |p - pStar|)⁻¹))
        (𝓝[≠] pStar) (nhds 0) := by
      simpa [mul_zero] using (Filter.Tendsto.abs hloginv).const_mul K
    rw [Metric.tendsto_nhds]
    intro ε hε
    filter_upwards [hK.eventually (gt_mem_nhds hε)] with p hp
    simp only [Real.dist_eq, sub_zero]
    exact lt_of_le_of_lt (hfun p) hp
  -- assemble
  exact Filter.Tendsto.congr' hid
    (by simpa [add_zero] using (tendsto_const_nhds (x := gamma)).add hcorr)

end Choptuik.Stability
