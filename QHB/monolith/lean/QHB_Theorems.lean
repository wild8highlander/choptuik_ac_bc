/- --- T14-дополнение: sup-лемма о худшей потере (закрытая лемма) ---/

/-- **T14.sup (exact, R6-прогресс).** Для любого унитарного профиля разность
значений в двух точках не превосходит 2 — алгебраическое ядро леммы о барьере.
Доказательство: |U(x) − U(y)| = |U(x) + (−U(y))| ≤ |U(x)| + |U(y)| ≤ 1 + 1. -/
theorem T14_sup_lemma (U : ℝ → ℝ) (hU : UnitProfile U) (x y : ℝ) :
    |U x - U y| ≤ 2 := by
  calc |U x - U y| = |U x + -(U y)| := by simp [sub_eq_add_neg]
    _ ≤ |U x| + |-(U y)| := abs_add (U x) (-(U y))
    _ = |U x| + |U y| := by rw [abs_neg]
    _ ≤ 1 + 1 := by linarith [hU x, hU y]
    _ = 2 := by norm_num

/-- Точка долины в единичном зазоре (asymmetry.X_STAR). -/
noncomputable def xStar : ℝ := 0.181777

/-- Определение потери барьера: η · |U(x*) − U(0)| (axiom-якорь к asymmetry.py). -/
axiom barrierLoss_def : ∀ (η : ℝ) (U : ℝ → ℝ), barrierLoss η U = η * |U xStar - U 0|

/-- **T14.worst (exact, R6-прогресс).** Худшая потеря барьера по унитарным
профилям не превосходит 2η; вместе с T14 (замок) это даёт точный порог η_crit. -/
theorem T14_worst_case (U : ℝ → ℝ) (hU : UnitProfile U) (η : ℝ) (hη : 0 ≤ η) :
    barrierLoss η U ≤ 2 * η := by
  rw [barrierLoss_def]
  exact mul_le_mul_of_nonneg_left (T14_sup_lemma U hU xStar 0) hη

/- --- T16: жёсткое вращение при неравных циркуляциях (R2) ---/

/-- Циркуляции трёх вихрей (Γ₁, Γ₂, Γ₃); все одноимённые: Γᵢ > 0. -/
def Circs : Type := ℝ × ℝ × ℝ

/-- Суммарная циркуляция. -/
def GammaTot (g : Circs) : ℝ := g.1 + g.2.1 + g.2.2

/-- **T16 (exact).** Равносторонний треугольник со стороной a и произвольными
одноимёнными циркуляциями — относительное равновесие: каждый вихрь движется
по окружности вокруг центра циркуляций с угловой скоростью ω = Γ_Σ/(2πa²).
Ключевой шаг: Σ_{j≠i} Γ_j (z_i − z_j) = Γ_Σ (z_i − c), где c — центр циркуляций
(доказывается кольцом с условием Σ Γ_j z_j = 0); дальше |z_i − z_j| = a. -/
theorem T16_anisotropic_rotation (g : Circs) (hg : 0 < GammaTot g) (a : ℝ) (ha : 0 < a)
    (z1 z2 z3 : ℂ)
    (hshape : Complex.abs (z1 - z2) = a ∧ Complex.abs (z2 - z3) = a ∧ Complex.abs (z3 - z1) = a)
    (hcen : (g.1 * z1 + g.2.1 * z2 + g.2.2 * z3) / GammaTot g = 0) :
    (1 / (2 * Real.pi)) * (g.2.1 * Complex.I * (z1 - z2) / a^2
                          + g.2.2 * Complex.I * (z1 - z3) / a^2)
      = (GammaTot g / (2 * Real.pi)) * Complex.I * z1 := by
  sorry  -- чистая алгебра: ring + hcen; численная верификация: dev < 6.9e-15 (R2)

/-- Следствие T16 (измеренный закон, R2): ω(γ) = (2+γ)/(2π) для Γ = (1, 1, γ). -/
theorem T16_gamma (γ : ℝ) (hγ : γ > 0) :
    GammaTot (1, 1, γ) = 2 + γ := by
  unfold GammaTot; norm_num

/- --- T17: расщепление пары ±iω — замкнутые законы ветвей (R2) ---/

/-- Измеренный спектр со-вращающейся системы: две частоты пар при циркуляциях
(1, 1, γ) (axiom-якорь к roadmap_results.json, r2_anisotropic). -/
axiom measuredFreqs : ℝ → ℝ × ℝ

/-- **T17 (measured-law, R2).** Законы ветвей: ν_tr(γ) = (2+γ)/(2π) и
ν_int(γ) = √(3(1+2γ))/(2π); макс. отклонение по скану 0.2 ≤ γ ≤ 5.0 < 5×10⁻⁹. -/
theorem T17_branch_laws (γ : ℝ) (hγ : 0.2 ≤ γ ∧ γ ≤ 5.0) :
    measuredFreqs γ = ((2 + γ) / (2 * Real.pi),
                       Real.sqrt (3 * (1 + 2 * γ)) / (2 * Real.pi)) := by
  sorry  -- данных-якорь: r2_anisotropic.max_dev_branches = 4.99e-9 (97 точек)

/-- **T17.γ=1 (exact, R6-прогресс).** При γ = 1 обе ветви вырождены в ±iω,
ω = 3/(2π) — воспроизведение канона T11. -/
theorem T17_gamma1_degenerate :
    (2 + 1) / (2 * Real.pi) = 3 / (2 * Real.pi) ∧
    Real.sqrt (3 * (1 + 2 * 1)) / (2 * Real.pi) = 3 / (2 * Real.pi) := by
  constructor <;> norm_num

/-- **T17.split (exact, ядро закрыто ring+linarith).** Расщепление пары квадратично по (γ−1):
разность ветвей D(γ) = (2+γ)/2π − √(3(1+2γ))/2π обращается в нуль ТОЛЬКО при γ = 1.
Ядро: (2+γ)² = 3(1+2γ) ⇔ (γ−1)² = 0. -/
theorem T17_split_quadratic (γ : ℝ) :
    (2 + γ)^2 = 3 * (1 + 2 * γ) ↔ (γ - 1)^2 = 0 := by
  have hid : (2 + γ)^2 - 3 * (1 + 2 * γ) = (γ - 1)^2 := by ring
  constructor
  · intro h
    have h' : (2 + γ)^2 - 3 * (1 + 2 * γ) = 0 := by linarith
    rw [hid] at h'
    exact h'
  · intro h
    have h' : (2 + γ)^2 - 3 * (1 + 2 * γ) = 0 := by
      rw [hid]; exact h
    linarith

/- --- T18: температурный замок (R3) ---/

/-- Попытная частота осциллятора зазора: ν = √(2K)/(2π), K = 0.35. -/
noncomputable def nuAttempt : ℝ := Real.sqrt (2 * 0.35) / (2 * Real.pi)

/-- Уровень честности пакета (окно C7). -/
noncomputable def epsH : ℝ := 1e-12

/-- Температурная граница замка: η_crit(T) = η_crit(0) − (T/2)·ln(Nν/ε_H),
обрезанная нулём (axiom-якорь к r3_thermal). -/
axiom etaCritT : ℝ → ℝ → ℝ → ℝ → ℝ

/-- **T18 (measured-law, R3).** Граница линейна по T; замок живёт ⇔
T < T_death = 2·η_crit(0)/ln(Nν/ε_H). При N = 10¹²: T_death ≈ 0.003414 ≈ T_c/26. -/
theorem T18_thermal_lock (N : ℝ) (hN : N ≥ 1e6) (T : ℝ) (hT : 0 ≤ T) :
    (etaCritT T N nuAttempt epsH > 0 ↔ T < 2 * etaCrit / Real.log (N * nuAttempt / epsH)) := by
  sorry  -- данные: r3_thermal.budgets; ядро — линейность etaCritT по T (linarith)

