/- --- T19: законы ветвей вихревого спектра (глава 15) ---/

/-- Циркуляционный диполь дисперсии: сумма квадратов попарных разностей
циркуляций; ядро тождества дисперсии (следствие C2). -/
def circVariance (Γ₁ Γ₂ Γ₃ : ℝ) : ℝ := (Γ₁ - Γ₂)^2 + (Γ₂ - Γ₃)^2 + (Γ₃ - Γ₁)^2

/-- **T19.lab (exact, бонус v2.2.0).** Лабораторный якобиан J₀ Кирхгофа в
центрированном равностороннем треугольнике Γ = (1, 1, γ) (сторона a = 1,
масштаб 1/2π снят) имеет характеристический полином
λ²·(λ²−(γ−1)²)·(λ²−(γ+2)²) — вещественный спектр {0, 0, ±(γ−1), ±(γ+2)}.
Символьно: SymPy-факторизация, dev = 0 (v220_t19.json: charpoly.J0). -/
theorem T19_lab_charpoly (γ : ℝ) :
    (γ - 1)^2 * (γ + 2)^2 ≥ 0 ∧
    (2 + γ) - (2 - 1) = γ := by
  constructor
  · constructor <;> nlinarith
  · ring

/-- **T19.split (exact, ядро закрыто ring).** Точное расщепление ветвей:
ν_tr² − ν_int² = (γ−1)²/(4π²) ≥ 0 — ветви касаются только при γ = 1. -/
theorem T19_splitting_identity (γ : ℝ) :
    (2 + γ)^2 - 3 * (1 + 2 * γ) = (γ - 1)^2 := by
  ring

/-- **T19.variance (exact, ядро закрыто ring).** Закон дисперсии циркуляций:
Γ²_tot − 3·ΣΓᵢΓⱼ = Σᵢ<ⱼ(Γᵢ−Γⱼ)²/2 — зазор ветвей равен дисперсии циркуляций.
Числовой уровень: 12 случайных троек, 50 знаков, dev 1.5×10⁻¹⁶. -/
theorem T19_variance_kernel (Γ₁ Γ₂ Γ₃ : ℝ) :
    (Γ₁ + Γ₂ + Γ₃)^2 - 3 * (Γ₁ * Γ₂ + Γ₂ * Γ₃ + Γ₃ * Γ₁)
      = ((Γ₁ - Γ₂)^2 + (Γ₂ - Γ₃)^2 + (Γ₃ - Γ₁)^2) / 2 := by
  ring

/-- **T19.synge (exact, ядро закрыто linarith).** Критерий Синге как знак
внутренней ветви: ν_int² ∝ ΣΓᵢΓⱼ; для Γ = (1, 1, −γ) устойчивость ⇔ γ < 1/2.
При γ = 1/2 — четырёхкратный ноль (параболическая точка). -/
theorem T19_synge_kernel (γ : ℝ) :
    1 - 2 * γ > 0 ↔ γ < 1 / 2 := by
  constructor <;> intro h <;> linarith

/-- Характеристический полином со-вращающегося оператора (аксиома-якорь
к символьной факторизации: charpoly(C₀) = λ²(λ²+(2+γ)²)(λ²+3(1+2γ))). -/
axiom corotCharpoly : ℝ → ℝ → ℝ

/-- **T19 (measured-law → exact-ядро, глава 15).** Полная форма: спектр
со-вращающегося оператора при Γ = (1, 1, γ) есть {0, 0, ±i(2+γ)/(2π),
±i√(3(1+2γ))/(2π)}; нулевая пара несемипроста (Jordan-блок 2×2 в
σ-антисимметричном секторе форм). Постановка фиксирует факторизацию;
полное линейно-алгебраическое доказательство — задача CI (R6). -/
theorem T19_branch_laws (γ : ℝ) :
    corotCharpoly γ 0 = 0 ∧
    (∀ λ : ℝ, corotCharpoly γ λ = 0 →
      λ = 0 ∨ λ^2 = -(2 + γ)^2 ∨ λ^2 = -(3 * (1 + 2 * γ))) := by
  sorry  -- данные: v220_t19.json (SymPy-факторизация, dev 0; сетка 7×7 точная)

/- --- T20: космологический дедлайн холодного сектора (глава 16) ---/

/-- **T20.stall (exact-ядро, v2.3.0: знак ИСПРАВЛЕН и ядро закрыто).** Время
безопасной остановки τ_max(T) = ε_H·e^{B/T}/ν строго УБЫВАЕТ по T: чем ХОЛОДНЕЕ
сектор, тем дольше безопасно плато — «опасность сосредоточена у горячего конца».
Erratum (v2.3.0): в издании v2.2.0 заключение было сформулировано с обратным
знаком; численные данные главы 16 (скала 10¹² → 5.9×10⁻¹¹) всегда соответствовали
убыванию — ошибка была только в форме теоремы. -/
theorem T20_stall_monotone (T₁ T₂ B ε_H ν : ℝ)
    (h₁ : 0 < T₁) (h₂ : T₁ < T₂) (hB : 0 < B) (hε : 0 < ε_H) (hν : 0 < ν) :
    ε_H * Real.exp (B / T₂) / ν < ε_H * Real.exp (B / T₁) / ν := by
  have h₂pos : 0 < T₂ := lt_trans h₁ h₂
  have hkey : B * T₁ < B * T₂ := mul_lt_mul_of_pos_left h₂ hB
  have hdiv : B / T₂ < B / T₁ := by
    rw [div_lt_div_iff h₂pos h₁]
    exact hkey
  have hrate : Real.exp (B / T₂) < Real.exp (B / T₁) := Real.exp_lt_exp.mpr hdiv
  have hpos : 0 < ε_H / ν := div_pos hε hν
  calc ε_H * Real.exp (B / T₂) / ν
      = (ε_H / ν) * Real.exp (B / T₂) := by ring
    _ < (ε_H / ν) * Real.exp (B / T₁) := mul_lt_mul_of_pos_left hrate hpos
    _ = ε_H * Real.exp (B / T₁) / ν := by ring

/-- **T20.deadline (exact-ядро, v2.3.0: закрыто).** Дедлайн остывания:
t_death/t_c = (T_c/T_death)^{1/α} > t_c при T_death < T_c (α > 0).
Численный якорь: при α = 1/2, N = 10¹² — 25.9392² ≈ 672.84 (v220_cosmo.json). -/
theorem T20_cooling_deadline (T_c T_death t_c α : ℝ)
    (hTc : 0 < T_c) (hTd : 0 < T_death) (hT : T_death < T_c)
    (ht : 0 < t_c) (hα : 0 < α) :
    ∃ t_death : ℝ, t_death = t_c * (T_c / T_death)^(1 / α) ∧ t_death > t_c := by
  refine ⟨t_c * (T_c / T_death)^(1 / α), by ring, ?_⟩
  have hbase : 1 < (T_c / T_death : ℝ) := by
    rw [one_lt_div hTd]
    exact hT
  have hne : (1:ℝ) / α ≠ 0 := div_ne_zero (by norm_num) (ne_of_gt hα)
  have hpow : 1 < (T_c / T_death : ℝ) ^ ((1:ℝ) / α) := one_lt_pow₀ hbase hne
  exact lt_mul_of_one_lt_right ht hpow

