  | exact | measuredLaw | honestNegative | hypothesis | comparison

/- Утверждение с пятиполевым бюджетом неопределённости. -/
structure Claim where
  id : String
  status : Status
  statistical : Option ℝ
  discretization : Option ℝ
  solver : Option ℝ
  parameter : Option ℝ
  model : Option ℝ

/-- **Дисциплина честности (аксиома политики).** Статус exact не присваивается
при ненулевой модельной компоненте бюджета неопределённости. -/
def HonestyDiscipline : Prop :=
  ∀ c : Claim, c.status = Status.exact → c.model = none

